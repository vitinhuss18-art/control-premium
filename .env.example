# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
LOG_LEVEL=info

# Supabase — preencher somente no ambiente protegido
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=client-documents

# Opcional e recomendado: assina o cookie do portal do cliente. Sem esta
# variável, o servidor deriva uma chave exclusiva da service role já protegida.
# Se configurar, gere pelo menos 32 caracteres e mantenha no cofre da hospedagem.
CLIENT_SESSION_SECRET=

# PIX — nomes genéricos; o provedor será definido no encerramento
PIX_PROVIDER=
PIX_API_BASE_URL=
PIX_CLIENT_ID=
PIX_CLIENT_SECRET=
PIX_WEBHOOK_SECRET=
PIX_CERTIFICATE=
PIX_CERTIFICATE_PASSWORD=

# WhatsApp oficial — preencher após a conexão verificada
WHATSAPP_PROVIDER=
WHATSAPP_API_BASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Assinatura eletrônica
SIGNATURE_PROVIDER=
SIGNATURE_API_BASE_URL=
SIGNATURE_API_KEY=
SIGNATURE_WEBHOOK_SECRET=

# Assinatura e cobrança do SaaS
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Compatibilidade com instalações antigas. Prefira os nomes acima.
BILLING_PROVIDER=mercado_pago
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
# O cartão é coletado e tokenizado somente pelo checkout do provedor.
# Nunca salve número do cartão, CVV ou token de pagamento aqui.

# IA assistiva — nunca decide crédito automaticamente
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_CENTS=

# E-mail transacional
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
